    {
      "name": "Benerail Access Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the response JSON\r",
              "const response = pm.response.json();\r",
              "\r",
              "// Check if the response contains the access_token\r",
              "if (response.access_token) {\r",
              "    // Set the access_token in the environment variable\r",
              "    pm.environment.set(\"access_token\", response.access_token);\r",
              "    console.log(\"Access token saved to environment: \", response.access_token);\r",
              "} else {\r",
              "    // Log an error if access_token is not found\r",
              "    console.error(\"No access_token found in the response\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
